{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Roguelike Strategy Lab Result",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "strategy_version",
    "maa_version",
    "roguelike_theme",
    "difficulty",
    "run_id",
    "start_time",
    "success",
    "final_floor"
  ],
  "properties": {
    "strategy_version": { "type": "string", "pattern": "^V[0-9]{3}$" },
    "maa_version": { "type": "string" },
    "maa_commit": { "type": "string" },
    "roguelike_theme": { "type": "string", "enum": ["Phantom", "Mizuki", "Sami", "Sarkaz", "JieGarden"] },
    "mode": { "type": ["string", "integer"] },
    "difficulty": { "type": ["integer", "string"] },
    "run_id": { "type": "string" },
    "start_time": { "type": "string" },
    "end_time": { "type": ["string", "null"] },
    "success": { "type": "boolean" },
    "ending": { "type": ["string", "null"] },
    "final_floor": { "type": ["integer", "string"] },
    "recruited_operators": {
      "type": "array",
      "items": {
        "type": ["string", "object"],
        "additionalProperties": true,
        "properties": {
          "name": { "type": "string" },
          "elite": { "type": ["integer", "null"] },
          "level": { "type": ["integer", "null"] },
          "source": { "type": ["string", "null"] }
        }
      }
    },
    "support_operator": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "elite": { "type": ["integer", "null"] },
        "level": { "type": ["integer", "null"] },
        "skill": { "type": ["integer", "null"] },
        "skill_level": { "type": ["integer", "null"] },
        "module": { "type": ["string", "null"] },
        "module_level": { "type": ["integer", "null"] },
        "friend": { "type": ["boolean", "null"] }
      }
    },
    "failure_reason": { "type": ["string", "null"] },
    "recognition_error": { "type": ["boolean", "string", "null"] },
    "notes": { "type": ["string", "null"] },
    "raw_log_paths": { "type": "array", "items": { "type": "string" } }
  }
}
